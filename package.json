{
  "name": "@starklabs/forge",
  "version": "2.0.2-oops.5",
  "description": "An object-oriented, TypeScript-first Express framework for building production-ready APIs with zero boilerplate.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Musa-Stark/forge.js.git"
  },
  "bugs": {
    "url": "https://github.com/Musa-Stark/forge.js/issues"
  },
  "keywords": [
    "stark-forge",
    "starklabs",
    "express",
    "node",
    "nodejs",
    "typescript",
    "backend",
    "framework",
    "api",
    "rest",
    "crud",
    "authentication",
    "auth",
    "mongoose",
    "mongodb",
    "zod",
    "file-upload",
    "health-check",
    "api-versioning",
    "boilerplate"
  ],
  "author": "Musa Stark",
  "license": "MIT",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fastest-levenshtein": "^1.0.16",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers-sumo": "^0.8.4",
    "mongoose": "^9.10.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "resend": "^6.32.0",
    "string-width": "^8.3.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
